---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import SubstackFeed from '../components/SubstackFeed.astro';
import SubstackEmbed from '../components/SubstackEmbed.astro';
import { getSubstackPosts } from '../utils/substack';

const latestPosts = await getSubstackPosts(6);
---

<BaseLayout title="Home">
  <Header />
  <main>
    <section class="max-w-6xl mx-auto px-6">
      <Hero />
    </section>

    <section class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold">Latest Writing</h2>
        <a href="/blog" class="text-accent hover:text-accent-hover font-mono text-sm transition-colors">
          View all →
        </a>
      </div>
      <SubstackFeed posts={latestPosts} />
    </section>

    <section class="max-w-6xl mx-auto px-6 py-8">
      <SubstackEmbed />
    </section>
  </main>
  <Footer />
</BaseLayout>