---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About" description="About Cian O'Leary - AI Infrastructure Engineer">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-8">About</h1>

    <div class="space-y-6 text-lg">
      <p class="text-text-secondary">
        I'm an AI Engineer.... (stay tuned)
      </p>

      <p class="text-text-secondary">
        With a background in software engineering.... (really tuned)
      </p>

      <p class="text-text-secondary">
        When I'm not building... (really <i>really</i> tuned)
      </p>
    </div>

    <hr class="border-border my-12" />

    <section>
      <h2 class="text-2xl font-bold mb-6">What I Believe</h2>
      <div class="space-y-4 text-text-secondary">
        <p>
          <strong class="text-text-primary">Infrastructure is foundational.</strong> Placeholder.
        </p>
        <p>
          <strong class="text-text-primary">Simplicity over cleverness.</strong> Slop.
        </p>
        <p>
          <strong class="text-text-primary">Documentation matters.</strong> for now.
        </p>
      </div>
    </section>

    <hr class="border-border my-12" />
  </main>
  <Footer />
</BaseLayout>