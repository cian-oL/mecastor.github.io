---
export interface Props {
  url?: string;
}

const { url = "https://olearylab.substack.com" } = Astro.props;
---

<div class="bg-surface border border-border rounded-lg p-6 text-center">
  <h3 class="text-xl font-semibold mb-2">Subscribe to the Newsletter</h3>
  <p class="text-text-secondary text-sm mb-4">
    Get the latest posts delivered straight to your inbox.
  </p>
  <a
    href={`${url}/subscribe`}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-block font-semibold py-3 px-6 rounded-lg transition-colors"
    style="background-color: var(--color-accent); color: #ffffff;"
  >
    Subscribe
  </a>
</div>